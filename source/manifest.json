{
  "manifest_version": 2,
  "name": "Pokemon Showdown HD",
  "description": "Implements HD Sprites of Pokemon for Showdown",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "PokemonShowdownHD@NathanMichael",
      "strict_min_version": "91.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icon.png", "96": "icon.png", "128": "icon.png" },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://pokemonshowdown.com/*",
    "*://*.pokemonshowdown.com/*",
    "*://psim.us/*",
    "*://*.psim.us/*",
    "*://raw.githubusercontent.com/*"
  ],
  "optional_permissions": ["*://*/*"],
  "browser_action": { "default_icon": "icon.png", "default_title": "Pokemon Showdown HD settings" },
  "background": { "scripts": ["config.js", "patch.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["*://pokemonshowdown.com/*", "*://*.pokemonshowdown.com/*", "*://psim.us/*", "*://*.psim.us/*"],
      "js": ["config.js", "loader.js"],
      "css": ["ui/panels.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "config.js",
    "page.js",
    "debug.js",
    "ui/component.js",
    "ui/panels.js",
    "ui/assets/*",
    "fx/*",
    "bg/battle-stadium.png",
    "bg/final-stadium.png",
    "bg/new-save.png",
    "bg_overlay/electric-terrain.png",
    "bg_overlay/grassy-terrain.png",
    "bg_overlay/misty-terrain.png",
    "bg_overlay/psycic-terrain.png",
    "bg_overlay/trickroom.png",
    "bg_overlay/magicroom.png",
    "bg_overlay/wonderroom.png"
  ]
}
